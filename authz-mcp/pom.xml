<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.pithos.authz</groupId>
        <artifactId>info-pithos-authz</artifactId>
        <version>1.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>info-pithos-authz-mcp</artifactId>
    <name>Pithos Authz Mcp</name>

    <!--
        MCP server module — exposes RBAC authz context and intent-level tools to AI agents.

        Depends only on rbac-service (same as rbac-app); never on rbac-app itself.
        Auth flows through the same RequestContext used by REST and gRPC.

        McpTool / McpResource / McpAuthenticator now live in
        info.pithos.service.container.core.mcp (shared across every app's MCP server, not
        RBAC-specific despite this module's package name) — see that package's Javadoc for
        the hand-rolled HTTP+SSE JSON-RPC transport (McpSseServer). No official MCP SDK
        dependency: it targets Servlet/WebFlux transports, not Vert.x, and this codebase
        already hand-rolls SSE parsing for LLM providers in runtime/llm rather than pull in
        provider SDKs — same call here.

        <parameters>true</parameters> below is required: McpToolRegistry resolves each tool's
        JSON arguments by the tool method's real parameter names via reflection.
    -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>info.pithos.rbac</groupId>
            <artifactId>info-pithos-rbac-service</artifactId>
        </dependency>
        <dependency>
            <groupId>info.pithos.service.container.core</groupId>
            <artifactId>info-pithos-service-container-core</artifactId>
            <!-- override: parent's pithos-runtime.version property (1.0.0-SNAPSHOT) predates the
                 mcp package this module now depends on; scoped here rather than bumping the
                 shared property, which ~18 unrelated dependencies also key off. -->
            <version>1.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>info.pithos.authn</groupId>
            <artifactId>info-pithos-authn-model</artifactId>
        </dependency>
        <dependency>
            <groupId>info.pithos.authn</groupId>
            <artifactId>info-pithos-authn-api</artifactId>
        </dependency>
        <dependency>
            <groupId>info.pithos.runtime.core.context</groupId>
            <artifactId>pithos-runtime-core-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
