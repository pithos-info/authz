meta {
  name: List Enterprises
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/enterprises?
  body: none
  auth: bearer
}

headers {
  x-user-id: 1
  x-enterprise-id: {{enterpriseId}}
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  enterpriseId: 1
  baseUrl: http://localhost:8080/rbac/v1
}
